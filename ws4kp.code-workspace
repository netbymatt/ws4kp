	},
	"extensions": {
		"recommendations": [
			"digitalbrainstem.javascript-ejs-support", // EJS (Embedded JavaScript) template language support
			"dbaeumer.vscode-eslint", // ESLint JavaScript linting integration
			"streetsidesoftware.code-spell-checker",
			"j69.ejs-beautify",
		]
	}
}
