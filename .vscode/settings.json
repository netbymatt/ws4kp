{
	"liveSassCompile.settings.formats": [
		{
			"format": "compressed",
			"extensionName": ".min.css",
			"savePath": "/server/styles",
		}
	],
	"search.exclude": {
		"**/node_modules": true,
		"**/bower_components": true,
		"**/*.code-search": true,
		"**/compiled.css": true,
		"**/*.min.js": true,
	},
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"cSpell.enabledFileTypes": {
		"markdown": true,
		"JavaScript": true
	},
	"cSpell.enabled": true,
	"cSpell.ignorePaths": [
		"**/package-lock.json",
		"**/node_modules/**",
		"**/vscode-extension/**",
		"**/.git/objects/**",
		".vscode",
		".vscode-insiders",
		"**/vendor/auto/**",
	],
