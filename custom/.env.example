# ATV fork: default display settings. Copy to the repo root as `.env` (gitignored),
# or pass as Docker environment variables. Any permalink parameter works as WSQS_<name>
# with dashes replaced by underscores (see README "Default query string parameters").

# default location: central Arkansas
WSQS_latLonQuery=Little Rock, AR, USA
WSQS_latLon={"lat":34.7487,"lon":-92.2749}

# displays
WSQS_travel=true
WSQS_regional_forecast=true
WSQS_latest_observations=true

# kiosk mode for signage (hides controls)
# WSQS_kiosk=true

# server port
# WS4KP_PORT=8080
